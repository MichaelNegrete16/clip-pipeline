# Copia este archivo como .env y pon tus credenciales.
# El .env NO se sube a git (ver .gitignore).

# Twitch — https://dev.twitch.tv/console/apps
# Requiere 2FA activo en la cuenta de Twitch para poder registrar la app.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube — se llenan en la fase de subida (OAuth por canal, en la base de datos)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
